#!/usr/bin/env python3
"""Dispatch Forge after trusted CI, then verify the activated build receipt."""
import json
import os
from pathlib import Path
import re
import sys
import time
import urllib.parse
import urllib.request

REPOSITORY = 'theeufj/spectra-media-agent'
WORKFLOW = '.github/workflows/ci.yml'
SITE = 'https://sitetospend.com'


def trusted_run(run):
    return (run.get('head_repository', {}).get('full_name') == REPOSITORY
            and run.get('head_branch') == 'master' and run.get('event') == 'push'
            and run.get('path') == WORKFLOW and run.get('status') == 'completed'
            and run.get('conclusion') == 'success'
            and re.fullmatch(r'[0-9a-f]{40}', run.get('head_sha', '')) is not None
            and type(run.get('id')) is int and run['id'] > 0
            and type(run.get('run_attempt')) is int and run['run_attempt'] > 0)


def latest_run(runs, sha):
    matching = [run for run in runs if run.get('head_sha') == sha
                and run.get('head_branch') == 'master' and run.get('event') == 'push'
                and run.get('path') == WORKFLOW]
    return max(matching, key=lambda run: (run['id'], run.get('run_attempt', 1)), default={})


def receipt_matches(receipt, run):
    return (receipt.get('repository') == REPOSITORY and receipt.get('workflow') == WORKFLOW
            and receipt.get('source_sha') == run['head_sha']
            and receipt.get('run_id') == run['id']
            and receipt.get('run_attempt') == run['run_attempt'])


def read_json(url, headers=None):
    request = urllib.request.Request(url, headers=headers or {'Accept': 'application/json'})
    with urllib.request.urlopen(request, timeout=25) as response:
        body = response.read(2 * 1024 * 1024 + 1)
    if len(body) > 2 * 1024 * 1024:
        raise ValueError('Response too large')
    return json.loads(body)


def main():
    event = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
    run = event.get('workflow_run', {})
    if not trusted_run(run):
        raise ValueError('Only successful master push CI from this repository may deploy')
    token = os.environ['GH_TOKEN']
    headers = {'Accept': 'application/vnd.github+json', 'Authorization': f'Bearer {token}',
               'X-GitHub-Api-Version': '2022-11-28'}
    api = f'https://api.github.com/repos/{REPOSITORY}'
    head = read_json(f'{api}/git/ref/heads/master', headers)['object']['sha']
    runs = read_json(f'{api}/actions/workflows/ci.yml/runs?head_sha={run["head_sha"]}&event=push&per_page=100', headers)['workflow_runs']
    latest = latest_run(runs, run['head_sha'])
    if head != run['head_sha'] or latest.get('id') != run['id'] or latest.get('run_attempt') != run['run_attempt']:
        print('Skipping superseded CI run; it will not trigger production.')
        return
    if latest.get('status') != 'completed' or latest.get('conclusion') != 'success':
        raise ValueError('Latest CI attempt is not successful')

    hook = urllib.parse.urlsplit(os.environ['FORGE_DEPLOY_HOOK'])
    if (hook.scheme != 'https' or hook.netloc != 'forge.laravel.com'
            or hook.path != '/servers/1179907/sites/3094000/deploy/http'
            or not urllib.parse.parse_qs(hook.query).get('token')):
        raise ValueError('The configured Forge hook is missing or invalid')
    query = urllib.parse.parse_qsl(hook.query) + [
        ('forge_deploy_branch', 'master'), ('forge_deploy_commit', run['head_sha']),
        ('forge_deploy_message', f'CI {run["id"]}/{run["run_attempt"]}: tested frontend assets'),
    ]
    hook_url = urllib.parse.urlunsplit(hook._replace(query=urllib.parse.urlencode(query)))
    request = urllib.request.Request(hook_url, data=b'', method='POST')
    # Do not retry an ambiguous webhook response: the deployment may already exist.
    with urllib.request.urlopen(request, timeout=25) as response:
        response.read(1024)
    print(f'Forge accepted deployment request for {run["head_sha"]}. Waiting for activation.', flush=True)
    deadline = time.monotonic() + 12 * 60
    while time.monotonic() < deadline:
        url = f'{SITE}/build/deployment.json?ci={run["id"]}-{run["run_attempt"]}&t={int(time.time())}'
        try:
            receipt = read_json(url, {'Accept': 'application/json', 'Cache-Control': 'no-cache'})
            if receipt_matches(receipt, run):
                # A build receipt proves activation; also check that Laravel responds.
                with urllib.request.urlopen(SITE + '/up', timeout=25) as response:
                    response.read(1024)
                print(f'Production activated the CI build for {run["head_sha"]}. Health check passed.')
                return
        except Exception:
            pass
        time.sleep(15)
    raise ValueError('Forge did not activate the expected CI build within 12 minutes; inspect Forge deployment logs')


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # urllib exceptions can include the secret webhook URL. Never print them.
        sys.exit('Deployment dispatch or activation verification failed. Check Forge logs; hook credentials are omitted.')
