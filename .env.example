APP_NAME="Site to Spend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sitetospend.com

# Campaign Testing Mode
# Set to true to create all campaigns as PAUSED (draft) for testing
# Set to false (or remove) for production - campaigns will be created as ENABLED
CAMPAIGN_TESTING_MODE=false
CAMPAIGN_DEFAULT_STATUS=ENABLED

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sitetospend
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sfo3
AWS_BUCKET=sitetospend
AWS_ENDPOINT=https://sfo3.digitaloceanspaces.com
AWS_URL=https://sitetospend.sfo3.cdn.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudflare Turnstile (Bot Detection)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────
# Stripe (Billing & Subscriptions)
# ─────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret — create at: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Metered ad-spend billing price ID (create a metered price in Stripe)
STRIPE_AD_SPEND_PRICE_ID=

# ─────────────────────────────────────────────────
# Google OAuth (User Login via Google)
# ─────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────
# Google Ads (MCC Management Account)
# ─────────────────────────────────────────────────
# Your Manager (MCC) account customer ID (no dashes, e.g. 1234567890)
GOOGLE_ADS_MCC_CUSTOMER_ID=
# Refresh token generated for the MCC account
GOOGLE_ADS_MCC_REFRESH_TOKEN=
# Set to true to use the test account (no real spend)
GOOGLE_ADS_USE_TEST_ACCOUNT=false

# ─────────────────────────────────────────────────
# Google Cloud / Vertex AI
# API keys are disallowed by org policy — use ADC (Application Default Credentials).
# 1. Create a service account in GCP with the "Vertex AI User" role.
# 2. Download the JSON key and place it on the server (e.g. /home/forge/.google/vertex-sa.json).
# 3. Set GOOGLE_APPLICATION_CREDENTIALS to that absolute path.
# ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/home/forge/.google/vertex-sa.json

# ─────────────────────────────────────────────────
# YouTube Data API v3 (PMax Video Asset Upload)
# ─────────────────────────────────────────────────
# Required to upload generated MP4 videos to YouTube before linking to PMax asset groups.
# 1. Enable YouTube Data API v3 in Google Cloud Console.
# 2. Use the OAuth Playground (developers.google.com/oauthplayground) to generate a
#    refresh token with scope: https://www.googleapis.com/auth/youtube.upload
# 3. Set the three values below.
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REFRESH_TOKEN=

# ─────────────────────────────────────────────────
# Google Custom Search API (Competitor Discovery)
# ─────────────────────────────────────────────────
# Create at: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ─────────────────────────────────────────────────
# Facebook Ads (Platform Business Manager — System User)
# ─────────────────────────────────────────────────
# Create app at: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Facebook Login Configuration ID (optional, for config-based login)
FACEBOOK_CONFIG_ID=
# Business Manager ID — create at: https://business.facebook.com/
FACEBOOK_BUSINESS_MANAGER_ID=
# System User token — generate at: Business Settings → System Users → Generate Token
# Must have ads_management, business_management, pages_manage_ads scopes
FACEBOOK_SYSTEM_USER_TOKEN=
# Platform Facebook Page ID used as publisher for all customer campaigns
FACEBOOK_PAGE_ID=

# ─────────────────────────────────────────────────
# Microsoft Ads (Manager Account)
# ─────────────────────────────────────────────────
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_TENANT_ID=common
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_REFRESH_TOKEN=
# Your Manager (MCC) account ID
MICROSOFT_ADS_MANAGER_ACCOUNT_ID=
MICROSOFT_ADS_ENVIRONMENT=production

# ─────────────────────────────────────────────────
# LinkedIn Ads (Management Account)
# ─────────────────────────────────────────────────
# Create app at: https://www.linkedin.com/developers/
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
LINKEDIN_ADS_REFRESH_TOKEN=
LINKEDIN_ADS_API_VERSION=202404

# ─────────────────────────────────────────────────
# Google Tag Manager (Platform-Managed)
# ─────────────────────────────────────────────────
# Refresh token for the platform's Google account with GTM edit+publish scopes
GTM_PLATFORM_REFRESH_TOKEN=
# GTM Account ID under which per-customer containers are created
GTM_PLATFORM_ACCOUNT_ID=

# ─────────────────────────────────────────────────
# AI — Campaign Generation
# ─────────────────────────────────────────────────
# Gemini — used for AI-assisted campaign creation (CampaignController, GeminiService)
# Get key at: console.cloud.google.com → APIs & Services → Credentials
GEMINI_API_KEY=

# ─────────────────────────────────────────────────
# Video Generation
# ─────────────────────────────────────────────────
# Vidu — primary video generation service
# Get key at: vidu.studio
VIDU_API_KEY=

# OpenRouter — default provider for fresh image + video creative (Grok Imagine).
# Leave empty to fall back to the Google stack (Gemini images, Veo video).
OPENROUTER_API_KEY=
# AI_IMAGE_PROVIDER=grok   # or 'gemini'
# AI_VIDEO_PROVIDER=grok   # or 'veo'
# Runway — fallback video generation service
# Get key at: runwayml.com
RUNWAY_API_KEY=

# ─────────────────────────────────────────────────
# Third-Party Services
# ─────────────────────────────────────────────────
# Firecrawl — web scraping for knowledge base
FIRECRAWL_API_KEY=
# Moz — domain authority metrics
MOZ_API_KEY=

# ─────────────────────────────────────────────────
# Monitoring (Laravel Nightwatch)
# ─────────────────────────────────────────────────
# Obtain from nightwatch.laravel.com after creating your project
NIGHTWATCH_TOKEN=

# ─────────────────────────────────────────────────
# Database Backups (spatie/laravel-backup)
# ─────────────────────────────────────────────────
# Offsite disk for backup storage (default: s3)
BACKUP_DISK=s3
# Encrypt backup archives (optional)
BACKUP_ARCHIVE_PASSWORD=
# Email address for backup failure/success notifications
BACKUP_NOTIFICATION_EMAIL=admin@spectramedia.com.au

# Sitetospend.com's own Microsoft Advertising account (own-site conversions).
# Both are required — a blank SOAP header attributes nothing.
# List them with: php artisan microsoftads:refresh-token --list-accounts
SPECTRA_MICROSOFT_ADS_ACCOUNT_ID=
SPECTRA_MICROSOFT_ADS_CUSTOMER_ID=

# ═════════════════════════════════════════════════
# The keys below were readable from config/ but had never been written down.
# Every one has a working default in config — nothing here is required to boot —
# but a default you cannot see is a default you cannot deliberately change, and
# the AI_MODEL_* overrides in particular are the documented escape hatch for
# CLAUDE.md's "never hardcode a model string" rule.
#
# They are COMMENTED OUT on purpose. `FOO=` is not the same as an absent FOO:
# env() returns "" for the former, so a blank line here overrides the config
# default with an empty string rather than deferring to it. That turns feature
# flags off, blanks model names, and casts numeric settings — including the
# GOOGLE_ADS_USD_RATE_* conversion rates — to 0. CI does `cp .env.example .env`,
# so a blank line here breaks the build; copied to a server, it would be worse.
# Uncomment a line only when you are setting it.
# ═════════════════════════════════════════════════

# ─────────────────────────────────────────────────
# AI models (config/ai.php)
# ─────────────────────────────────────────────────
# Override any of these to pin a model without a code change. Leave blank to
# take the config default. Pricing for a model must exist in config/ai.php's
# cost table or its spend goes unrecorded.
# AI_MODEL_PRO=
# AI_MODEL_DEFAULT=
# AI_MODEL_LITE=
# AI_MODEL_EMBEDDING=
# Where embedding calls go when the primary returns 429. This model has its own
# quota pool — but it embeds into a *different space* at the same 3072
# dimensions, so its vectors cannot be compared to the primary's. Rows record
# which model produced them and search only compares within one space; run
# `php artisan embeddings:refresh --mismatched` to rebuild the rest. Set to an
# empty string to fail the embedding instead of falling back.
# AI_MODEL_EMBEDDING_FALLBACK=
# AI_MODEL_IMAGE=
# AI_MODEL_VIDEO=
# AI_MODEL_TTS=
# Grok models, used when the provider below is 'grok'
# AI_MODEL_IMAGE_GROK=
# AI_MODEL_VIDEO_GROK=

# 'grok' (via OpenRouter, needs OPENROUTER_API_KEY) or 'google' (Gemini/Veo).
# Falls back to the Google stack automatically when Grok is unavailable.
# AI_IMAGE_PROVIDER=
# AI_VIDEO_PROVIDER=
# Gemini TTS voice used to re-voice Veo-path videos
# AI_TTS_VOICE=
# Set false to skip the TTS re-voicing pass entirely
# AI_VIDEO_NARRATION_TTS=

# Guardrails on the seasonal budget shift job — a bad AI multiplier against a
# real ad account spends real money.
# AI_SEASONAL_MAX_DAILY_BUDGET=
# AI_SEASONAL_NO_BASELINE_CAP=

# ─────────────────────────────────────────────────
# Google Ads (config/googleads.php)
# ─────────────────────────────────────────────────
# GOOGLE_ADS_API_VERSION=
# Spectra's own Google Ads account, for first-party conversion upload
# SPECTRA_GOOGLE_ADS_CUSTOMER_ID=
# Minimum spend before a customer gets their own sub-account provisioned
# GOOGLE_ADS_ACCOUNT_CREATION_THRESHOLD_USD=
# Static USD conversion rates. Budgets cross currencies here, so a stale rate is
# a silent mispricing — review these when a rate drifts far enough to matter.
# GOOGLE_ADS_USD_RATE_AUD=
# GOOGLE_ADS_USD_RATE_NZD=
# GOOGLE_ADS_USD_RATE_GBP=
# GOOGLE_ADS_USD_RATE_EUR=
# GOOGLE_ADS_USD_RATE_CAD=

# ─────────────────────────────────────────────────
# Facebook / Microsoft (config/facebook.php, config/microsoftads.php)
# ─────────────────────────────────────────────────
# FACEBOOK_GRAPH_VERSION=
# FACEBOOK_REDIRECT_URI=
# Spectra's own pixel, for first-party conversion tracking
# FACEBOOK_SPECTRA_PIXEL_ID=
# MICROSOFT_ADS_UET_TAG_ID=

# ─────────────────────────────────────────────────
# Billing (config/billing.php, config/services.php)
# ─────────────────────────────────────────────────
# Legacy fallbacks for STRIPE_PUBLISHABLE_KEY / STRIPE_SECRET_KEY above. Set
# those, not these.
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_SETUP_FEE_USD_CENTS=
# Seconds of clock skew tolerated on webhook signatures
# STRIPE_WEBHOOK_TOLERANCE=
# Months a customer must stay before the early-exit fee stops applying
# EARLY_EXIT_MINIMUM_MONTHS=

# ─────────────────────────────────────────────────
# Crawling (config/crawl.php)
# ─────────────────────────────────────────────────
# Hard cap per site — the crawl is the input to brand extraction, not an archive
# CRAWL_MAX_PAGES_PER_SITE=
# Fraction of the page budget reserved for product pages on ecommerce sites
# CRAWL_PRODUCT_PAGE_SHARE=
# Chromium for Browsershot; set when node is not on the default PATH
# NODE_BINARY_PATH=
# BROWSERSHOT_PAGE_TIMEOUT=

# ─────────────────────────────────────────────────
# Feature flags and limits
# ─────────────────────────────────────────────────
# FIRST_CAMPAIGN_ENABLED=
# EMAIL_SEQUENCES_ENABLED=
# EMAIL_SEQUENCE_MAX_PER_RUN=
# EMAIL_SEQUENCE_REPLY_NOTIFY=
# SUPPORT_CHAT_ENABLED=
# SUPPORT_CHAT_MAX_MESSAGES=
# SUPPORT_CHAT_MAX_MESSAGE_LENGTH=
# SUPPORT_CHAT_MAX_AI_PER_DAY=
# SUPPORT_CHAT_MAX_OPEN_TICKETS=
# FEATURE_USAGE_ENABLED=
# FEATURE_USAGE_RETENTION_DAYS=
# ACTIVITY_LOG_RETENTION_DAYS=

# ─────────────────────────────────────────────────
# Alerting and integrations
# ─────────────────────────────────────────────────
# Alert when OpenRouter credit drops below this many dollars — at zero, creative
# generation silently falls back from Grok to the Gemini/Veo stack.
# OPENROUTER_LOW_CREDIT_ALERT=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# Alternative mail transports to the configured default
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# POSTMARK_TOKEN=

# Direct Gemini API key. Only needed for the non-Vertex code paths — the main
# stack authenticates through GOOGLE_APPLICATION_CREDENTIALS above.
# GEMINI_API_KEY is accepted as a fallback name.
# GOOGLE_GEMINI_API_KEY=

# ─────────────────────────────────────────────────
# Storage and tenancy
# ─────────────────────────────────────────────────
# Only when the S3 disk needs different values from the AWS_* block above
# S3_BUCKET=
# AWS_REGION=
# CLOUDFRONT_DOMAIN=
# Force a tenant skin regardless of the requesting host. Local development only
# — in production the skin is resolved from the domain (config/tenants.php).
# TENANT_OVERRIDE=
