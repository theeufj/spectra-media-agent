{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_trailing_whitespace": true,
        "no_whitespace_in_blank_line": true,
        "single_trait_insert_per_statement": false
    },
    "exclude": [
        "bootstrap/cache",
        "node_modules",
        "storage",
        "vendor"
    ]
}
